{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nome", "preco", "estoque"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "preco": {
      "type": "number",
      "minimum": 0
    },
    "estoque": {
      "type": "boolean"
    }
  }
}
